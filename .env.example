# ========================================================
# Apotek Vitaria Environment Configuration
# ========================================================

# PostgreSQL Database Connection URL (Supabase, Neon.tech, or Vercel Postgres)
# Example Supabase: postgresql://postgres.xxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Example Neon: postgresql://neondb_owner:xxxx@ep-cool-dawn.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Example Vercel Postgres: Automatically injected as POSTGRES_URL or DATABASE_URL on Vercel
DATABASE_URL="postgresql://postgres:password@localhost:5432/vitaria"

# Application Environment
NODE_ENV="production"
